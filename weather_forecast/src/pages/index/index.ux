  /* 允许该列根据需要增长 */
  flex-grow: 1;
  /* 移除 flex: 1 */
  display: flex;
  /* 根据需要对齐文本 */
  flex-direction: column; /* 内部元素垂直排列 */
  justify-content: center; /* 使日期和温度作为一个整体在垂直方向居中 */
  align-items: flex-start; /* 使日期和温度文本左对齐 */
  padding: 0px 40px;
}

.right-column {
    flex: 0 0 80px; /* 设置一个基础宽度，例如80px，不伸缩 */
    display: flex;
    justify-content: center; /* 水平居中内部元素 */
    align-items: center; /* 垂直居中内部元素 */
    padding: 0px 35px; /* 列表项内部左右边距 */
    /* border: 1px solid green; */ /* 调试用 */
}


  .text {
    color: #ffffff; /* 默认文字颜色为白色 */ 
  }

  /* 顶部信息样式 */
