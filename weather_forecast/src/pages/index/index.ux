<template>
  <!-- 确保所有内容都在这一个根 div 内 -->
  <div class="page">
    <div class="bg-image"></div>
    <!-- 顶部信息 -->
    <div class="header">
      <text class="current-time">{{ currentTime }}</text>
      <text class="forecast-title">{{ forecastTitle }}</text>
    </div>

    <!-- 天气预报列表 -->
    <list class="weather-list">
      <list-item type="forecast" for="{{ weatherList }}" class="list-item">
        <div class="list-item-container" onclick="toListPage($item)">
          <!-- 左侧列：包含日期和温度 -->
          <div class="left-column">
            <text class="data">{{ $item.day }}</text>
            <text class="temperature">{{ $item.tempHigh }}°/{{ $item.tempLow }}°</text>
          </div>
          <!-- 右侧列：包含天气图标 -->
          <div class="right-column">
            <image class="weather-icon" src="{{ $item.icon }}"></image>
          </div>
        </div> <!-- list-item-container 的结束标签 -->
      </list-item>
    </list>
  </div> <!-- page (根元素) 的结束标签 -->
</template>



<style>
  /* 基础样式 */
.html, .body {
  width: 100%;
  height: 100%;
  margin: 0;
  padding: 0;
  overflow: hidden;
}

  .page {
  width: 100%;
  height: 100%;
